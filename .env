# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=793f94deb784f586911a0e9eb228f921
###< symfony/framework-bundle ###
###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=sync://
###< symfony/messenger ###

###> symfony/mailer ###
# MAILER_DSN=null://null
###< symfony/mailer ###

###> doctrine/mongodb-odm-bundle ###
# Format described at https://www.mongodb.com/docs/php-library/current/connect/connection-options/
# MONGODB_URL="mongodb://username:password@localhost:27017/?authSource=auth-db"
# MONGODB_URL="mongodb+srv://username:password@YOUR_CLUSTER_NAME.YOUR_HASH.mongodb.net/?retryWrites=true&w=majority"
MONGODB_URL=mongodb://127.0.0.1:27017
MONGODB_DB=symfony_certification
###< doctrine/mongodb-odm-bundle ###
###> OPENAI API KEY #
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
###< OPENAI API KEY ###
###> MAILER DSN ###
MAILER_DSN=smtp://smtp.example.com:587?encryption=tls&auth
###< MAILER DSN ###
###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> Browser & WebDrivers ###
# Default browser for crawlers (chrome, firefox, edge)
BROWSER=chrome

# Default WebDriver paths (override in .env.local as needed)
CHROME_DRIVER_PATH=/var/www/html/github-ask/certibot/drivers/chromedriver
GECKO_DRIVER_PATH=/var/www/html/github-ask/certibot/drivers/geckodriver
EDGE_DRIVER_PATH=/var/www/html/github-ask/certibot/drivers/msedgedriver
###< Browser & WebDrivers ###

###> driver-auto-update ###
# Enable automatic driver updates before crawl commands
# Set to true to enable, false to disable (default: false)
DRIVER_AUTO_UPDATE_ENABLED=false

# Interval between driver version checks (in seconds)
# Default: 86400 (24 hours)
DRIVER_CHECK_INTERVAL=86400

# Timeout for driver update process (in seconds)
# Default: 120 (2 minutes)
DRIVER_UPDATE_TIMEOUT=120
###< driver-auto-update ###

