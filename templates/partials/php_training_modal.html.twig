<!-- Modal for PHP quiz training duration -->
<div class="modal fade" id="phpTrainingModal" tabindex="-1" aria-labelledby="phpTrainingModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="phpTrainingModalLabel">PHP Quiz — Training duration</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>How long would you like to train?</p>
                <form id="phpTrainingForm">
                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="phpDuration" id="phpDuration90" value="90" checked/>
                            <label class="form-check-label" for="phpDuration90">90 minutes</label>
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="form-check">
                            <p id="phpDurationErrorMessage" class="text-danger" style="display: none;">Please indicate the duration you wish to train for.</p>
                            <input class="form-check-input" type="radio" name="phpDuration" id="phpDurationOther" value="custom"/>
                            <label class="form-check-label" for="phpDurationOther">
                                Other duration (&lt;90 min):
                                <input type="number" class="form-control mt-2" id="phpCustomDuration" name="phpCustomDuration" min="1" max="89">
                            </label>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="phpStartQuizBtn">Start PHP Quiz</button>
            </div>
        </div>
    </div>
</div>

